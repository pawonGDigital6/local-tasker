{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 2,
  "name": "acf-block/area-calculator",
  "version": "0.1.0",
  "title": "Area Calculator",
  "category": "acf-blocks",
  "icon": "calculator",
  "description": "Standalone room-by-room area calculator. Works on any page — no WooCommerce product required.",
  "keywords": [
    "calculator",
    "area",
    "sqm",
    "rooms",
    "flooring"
  ],
  "attributes": {
    "previewImage": {
      "type": "string",
      "default": "preview.png"
    }
  },
  "supports": {
    "html": false,
    "anchor": true
  },
  "textdomain": "area-calculator",
  "editorScript": "file:./index.js",
  "editorStyle": "file:./index.css",
  "style": "file:./style-index.css",
  "viewStyle": "file:./view.css",
  "viewScript": "file:./view.js",
  "acf": {
    "mode": "preview",
    "renderTemplate": "render.php"
  }
}